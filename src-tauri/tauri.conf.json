{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerminalVoice",
  "version": "0.1.2",
  "identifier": "com.terminalvoice.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TerminalVoice",
        "width": 520,
        "height": 600,
        "minWidth": 400,
        "minHeight": 500,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "ball",
        "title": "TerminalVoice Ball",
        "width": 80,
        "height": 80,
        "x": 100,
        "y": 100,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "url": "#/ball"
      },
      {
        "label": "panel",
        "title": "TerminalVoice Panel",
        "width": 388,
        "height": 620,
        "x": 180,
        "y": 80,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "url": "#/panel"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1NThGOUQ1RTkzNjU3MUYKUldRZlZ6YnAxZmxZSlkzNHY1a0tldVEwcHlCYjFkV3hQWlBhZlMxV3AxK1FDWFdITWxTM0FnRDIK",
      "endpoints": [
        "https://github.com/lucan6290/TerminalVoice/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      }
    },
    "copyright": "© 2026 TerminalVoice",
    "category": "Utility",
    "shortDescription": "Windows 平台常驻全局语音输入桌面工具",
    "longDescription": "TerminalVoice — Windows 平台常驻全局语音输入桌面工具，支持语音输入、朗读选中文本、翻译/口译三大核心功能。"
  }
}
