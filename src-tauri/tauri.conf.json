{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerminalVoice",
  "version": "0.1.0",
  "identifier": "com.terminalvoice.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TerminalVoice",
        "width": 900,
        "height": 640,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
